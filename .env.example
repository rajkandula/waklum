# Copy to .env.local for development. Never commit real values.

# --- Required ----------------------------------------------------------------

# MongoDB (include the database name in the path)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority"

# Signs session cookies. Required in production: `openssl rand -hex 32`
JWT_SECRET=""

# Public origin of this deployment, no trailing slash. Used in email links,
# the OAuth metadata AI assistants discover, and the connector URL shown on
# the home page. Inlined into the browser bundle at build time.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- AI (the in-app assistant and generated diagrams) ------------------------

# A Gemini API key. Without it the in-app AI assistant and generated diagrams
# do not work; the rest of the app and the connector do (docs are saved
# without their diagrams).
GOOGLE_GENERATIVE_AI_API_KEY=""

# --- File storage: any S3-compatible bucket -----------------------------------
# Project files and task attachments. Without these, uploads answer 503.

STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT="https://s3.your-provider.example"
STORAGE_PUBLIC_URL="https://files.your-domain.example"
# STORAGE_REGION="auto"

# --- Email: Harakumo Mail -----------------------------------------------------
# Invites, password resets and task/project notifications. Create a key at
# Harakumo → Settings → API keys and turn on Mail for your project. Without it,
# nothing is emailed (each failure is logged): invites are still saved, but
# invite and password-reset links only ever reach people by email.

HARAKUMO_API_KEY=""
# HARAKUMO_BASE_URL="https://harakumo.com"
# Display name on every email (default "Waklum")
MAIL_FROM_NAME=""
# Sender address on a domain you verified in Harakumo → Mail (optional)
MAIL_FROM=""

# --- Admin -------------------------------------------------------------------
# Comma-separated emails that may open /admin. Empty means nobody.
ADMIN_EMAILS=""

# --- Billing: Stripe (optional) ----------------------------------------------
# Without these the app runs on the Free plan limits and upgrades answer 503.

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Monthly recurring Price ids from your own Stripe account
STRIPE_PRICE_PRO=""
STRIPE_PRICE_TEAM=""
